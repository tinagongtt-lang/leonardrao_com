DEBUG=True
SECRET_KEY=change-me-in-production
# 本地开发用本机 IP；上线时改成服务器公网 IP，例如 45.56.114.195
ALLOWED_HOSTS=45.56.114.195,192.168.31.79,localhost,127.0.0.1

# HSTS 秒数，本地开发设为 0；上线 HTTPS 后设为 31536000
HSTS_SECONDS=0
# 上线并启用 HTTPS 后设为 True
SECURE_SSL_REDIRECT=False
COOKIE_SECURE=False

# 登录失败锁定：5 次失败后锁定 10 分钟
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=10

DB_NAME=leonardrao
DB_USER=leonard
DB_PASSWORD=leonardpass
DB_HOST=localhost
DB_PORT=5433
